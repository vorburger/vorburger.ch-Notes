#!/bin/bash
set -eo pipefail

# Build script for Michael Vorburger.ch Blog

HUGO_ARGS="--enableGitInfo --gc --minify"

if command -v hugo >/dev/null 2>&1; then
    echo HUGO_VERSION="$HUGO_VERSION"
    echo "Found hugo in PATH, building..."
    hugo version
    hugo $HUGO_ARGS
elif command -v nix >/dev/null 2>&1; then
    echo "hugo not found in PATH, but nix found. Building with nix..."
    nix run nixpkgs#hugo -- version
    nix run nixpkgs#hugo -- $HUGO_ARGS
else
    echo "Error: Neither 'hugo' nor 'nix' was found in your PATH." >&2
    echo "Please install Hugo (https://gohugo.io/installation/) or Nix (https://nixos.org/download.html)." >&2
    exit 1
fi

echo "Build complete. Output is in the 'site/' directory."

if ! command -v lychee >/dev/null 2>&1; then
    echo "lychee not found in PATH, downloading pre-built binary..."
    LYCHEE_TMP=$(mktemp -d)
    curl -fSL "https://github.com/lycheeverse/lychee/releases/latest/download/lychee-x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz -C "$LYCHEE_TMP" \
        || { echo "Error: Failed to download or extract lychee." >&2; exit 2; }
    if [ ! -x "$LYCHEE_TMP/lychee" ]; then
        echo "Error: lychee binary not found after extraction." >&2
        exit 2
    fi
    export PATH="$LYCHEE_TMP:$PATH"
fi
echo "Checking links with lychee..."
lychee site/
